# ==============================================================================
# Skating Competition Alert - Environment Configuration
# ==============================================================================

# Enabled notification dispatchers (comma-separated: whatsapp, telegram, discord, email, console)
# Default: console (prints to terminal and log)
NOTIFIERS_ENABLED=console,whatsapp

# ------------------------------------------------------------------------------
# 1. WhatsApp Configuration (CallMeBot API)
# ------------------------------------------------------------------------------
# Phone number in international format without '+' or spaces (e.g. 4512345678)
CALLMEBOT_PHONE=
# API key obtained via WhatsApp message to CallMeBot (+34 941 01 99 62: "I allow callmebot to send me messages")
CALLMEBOT_API_KEY=

# ------------------------------------------------------------------------------
# 2. Telegram Configuration (Optional)
# ------------------------------------------------------------------------------
# Bot token from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=
# Target Chat ID or Channel ID (e.g. 123456789 or @your_channel)
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 3. Discord Configuration (Optional)
# ------------------------------------------------------------------------------
# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 4. Email Configuration (SMTP) (Optional)
# ------------------------------------------------------------------------------
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_TO=

# ------------------------------------------------------------------------------
# Scanner & Polling Settings
# ------------------------------------------------------------------------------
# Interval in seconds when running in daemon mode (default: 300 = 5 minutes)
CHECK_INTERVAL_SECONDS=300

# Notify on ANY new competition that opens for registration (true/false)
ALERT_ON_ANY_NEW_COMPETITION=true
