# ==============================================================================
# Skating Competition Alert - Environment Configuration (WhatsApp via CallMeBot)
# ==============================================================================

# Enabled notification dispatchers (comma-separated: whatsapp, console)
NOTIFIERS_ENABLED=console,whatsapp

# ------------------------------------------------------------------------------
# WhatsApp Configuration (CallMeBot API)
# ------------------------------------------------------------------------------
# Phone number in international format without '+' or spaces (e.g. 4512345678)
CALLMEBOT_PHONE=

# API key obtained via WhatsApp message to CallMeBot (+34 941 01 99 62: "I allow callmebot to send me messages")
CALLMEBOT_API_KEY=

# ------------------------------------------------------------------------------
# Scanner & Polling Settings
# ------------------------------------------------------------------------------
# Interval in seconds when running in local daemon mode (default: 300 = 5 minutes)
CHECK_INTERVAL_SECONDS=300
